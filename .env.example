# From Supabase: Project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Public address of your deployed site, used for guest links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Supabase: Project settings > API keys > service_role (or a "secret" key).
# Used only to record Razorpay orders and publish an invitation after payment.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay: Dashboard > Account & Settings > API keys. Use rzp_test_ keys until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay: Settings > Webhooks > <site>/api/pay/webhook, events payment.captured and order.paid
RAZORPAY_WEBHOOK_SECRET=
