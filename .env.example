# From Supabase: Project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Public address of your deployed site, used for guest links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Any random text of 32+ characters (for example: openssl rand -hex 24).
# Lets the server record Razorpay orders and confirm payments, and nothing else.
# After adding it and redeploying, press Admin -> Settings -> Connect payments.
PAYMENTS_DB_SECRET=

# Razorpay: Dashboard > Account & Settings > API keys. Use rzp_test_ keys until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay: Settings > Webhooks > <site>/api/pay/webhook, events payment.captured and order.paid
RAZORPAY_WEBHOOK_SECRET=
